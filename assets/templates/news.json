{
  "_page_style": "body{max-width:700px;margin:0 auto;padding:18px;font-family:'PingFang SC','Microsoft YaHei','Helvetica Neue',sans-serif;color:#222;line-height:2;background:#fefefe;}",
  "h1": "font-size:24px;font-weight:800;color:#c00;margin:20px 0 14px 0;text-align:center;letter-spacing:1px;",
  "h2": "font-size:18px;font-weight:700;color:#1a1a1a;margin:18px 0 10px 0;padding:8px 0 6px 12px;border-left:4px solid #c00;",
  "h3": "font-size:16px;font-weight:700;color:#333;margin:14px 0 8px 0;",
  "h4": "font-size:15px;font-weight:600;color:#555;margin:12px 0 6px 0;",
  "p": "margin:10px 0;font-size:16px;color:#333;text-align:justify;text-indent:2em;",
  "strong": "color:#c00;font-weight:700;",
  "em": "color:#666;font-style:italic;",
  "blockquote": "margin:16px 0;padding:14px 18px;background:#fff5f5;border-left:4px solid #c00;color:#555;font-size:15px;border-radius:0 6px 6px 0;",
  "pre": "margin:16px 0;padding:16px;background:#1a1a1a;color:#f0f0f0;border-radius:4px;overflow-x:auto;font-size:14px;line-height:1.7;",
  "code": "font-family:'Consolas',monospace;background:#fff0f0;color:#c00;padding:2px 6px;border-radius:3px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:24px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:6px 0;font-size:16px;color:#333;",
  "a": "color:#c00;text-decoration:none;border-bottom:1px solid #c00;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;",
  "th": "background:#c00;color:#fff;font-weight:700;padding:10px 14px;border:none;",
  "td": "padding:9px 14px;border-bottom:1px solid #f0e0e0;color:#333;",
  "hr": "border:none;border-top:2px solid #eee;margin:20px 0;",
  "del": "color:#bbb;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}