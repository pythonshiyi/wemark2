{
  "_page_style": "body{max-width:660px;margin:0 auto;padding:32px 24px;font-family:'Courier New','Consolas','Source Code Pro','Noto Sans Mono CJK SC',monospace;color:#2a2a2a;line-height:2;background:#fcfcf9;}",
  "h1": "font-size:20px;font-weight:700;color:#1a1a1a;margin:32px 0 20px 0;text-transform:uppercase;letter-spacing:2px;text-align:center;",
  "h2": "font-size:16px;font-weight:700;color:#2a2a2a;margin:24px 0 14px 0;text-transform:uppercase;letter-spacing:1px;border-bottom:1px dashed #ccc;padding-bottom:8px;",
  "h3": "font-size:15px;font-weight:700;color:#3a3a3a;margin:18px 0 10px 0;",
  "h4": "font-size:14px;font-weight:700;color:#4a4a4a;margin:14px 0 8px 0;",
  "h5": "font-size:13px;font-weight:700;color:#5a5a5a;margin:12px 0 6px 0;",
  "h6": "font-size:12px;font-weight:700;color:#6a6a6a;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:1px;",
  "p": "margin:12px 0;font-size:14px;color:#2a2a2a;text-indent:2em;",
  "strong": "color:#1a1a1a;font-weight:700;text-decoration:underline;text-decoration-style:wavy;text-underline-offset:4px;",
  "em": "color:#5a5a5a;font-style:italic;",
  "blockquote": "margin:18px 0;padding:14px 20px;border-left:3px solid #2a2a2a;background:#f5f5f0;color:#4a4a4a;font-size:13px;text-indent:0;",
  "pre": "margin:16px 0;padding:16px 18px;background:#2a2a2a;border-radius:0;overflow-x:auto;font-size:13px;line-height:1.8;color:#e0e0e0;",
  "code": "font-family:'Courier New','Consolas',monospace;background:#f0f0eb;color:#2a2a2a;padding:1px 5px;font-size:13px;",
  "pre code": "background:transparent;color:#e0e0e0;padding:0;font-size:13px;",
  "ul": "margin:10px 0;padding-left:24px;list-style-type:'- ';",
  "ol": "margin:10px 0;padding-left:28px;list-style-type:decimal;",
  "li": "margin:6px 0;font-size:14px;color:#2a2a2a;text-indent:0;",
  "a": "color:#2a2a2a;text-decoration:underline;text-underline-offset:3px;",
  "img": "max-width:90%;height:auto;margin:16px auto;display:block;border:1px solid #ddd;padding:4px;background:#fff;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:13px;font-family:'Courier New','Consolas',monospace;",
  "th": "background:#2a2a2a;color:#fcfcf9;font-weight:700;padding:8px 12px;border:1px solid #2a2a2a;text-transform:uppercase;font-size:12px;letter-spacing:0.5px;",
  "td": "padding:8px 12px;border:1px solid #ccc;color:#2a2a2a;",
  "hr": "border:none;border-top:3px double #2a2a2a;margin:28px 0;",
  "del": "color:#aaa;text-decoration:line-through;"
}
