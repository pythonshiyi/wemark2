{
  "_page_style": "body{max-width:680px;margin:0 auto;padding:22px;font-family:'PingFang SC','Microsoft YaHei','Georgia',serif;color:#3a5a40;line-height:2;background:linear-gradient(to bottom,#f9fdf9,#fff);}",
  "h1": "font-size:22px;font-weight:700;color:#2d6a4f;margin:22px 0 14px 0;padding-bottom:10px;border-bottom:2px solid #52b788;text-align:center;",
  "h2": "font-size:18px;font-weight:700;color:#40916c;margin:18px 0 10px 0;padding-left:8px;border-left:3px solid #95d5b2;",
  "h3": "font-size:16px;font-weight:700;color:#52b788;margin:14px 0 8px 0;",
  "h4": "font-size:15px;font-weight:600;color:#74c69d;margin:12px 0 6px 0;",
  "p": "margin:10px 0;font-size:15px;color:#3a5a40;letter-spacing:0.3px;",
  "strong": "color:#1b4332;font-weight:700;",
  "em": "color:#52b788;font-style:italic;",
  "blockquote": "margin:14px 0;padding:14px 18px;background:#f0faf5;border-radius:8px;color:#40916c;font-size:14px;border:1px solid #b7e4c7;",
  "pre": "margin:14px 0;padding:14px;background:#f0faf5;border-radius:8px;font-size:14px;line-height:1.7;border:1px solid #d8f3dc;",
  "code": "font-family:'Consolas',monospace;background:#d8f3dc;color:#2d6a4f;padding:2px 6px;border-radius:3px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:24px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:5px 0;font-size:15px;color:#3a5a40;",
  "a": "color:#2d6a4f;text-decoration:none;border-bottom:1px solid #95d5b2;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;",
  "th": "background:#52b788;color:#fff;font-weight:700;padding:10px 14px;border:none;",
  "td": "padding:9px 14px;border-bottom:1px solid #d8f3dc;color:#3a5a40;",
  "hr": "border:none;height:1px;background:linear-gradient(to right,transparent,#95d5b2,transparent);margin:22px 0;",
  "del": "color:#b7e4c7;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}