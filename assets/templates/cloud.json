{
  "_page_style": "body{max-width:620px;margin:0 auto;padding:38px 30px;font-family:'PingFang SC','Microsoft YaHei',sans-serif;color:#5a5a6a;line-height:2.2;background:linear-gradient(180deg,#fafcfe,#fefefe,#f8fafe);}",
  "h1": "font-size:20px;font-weight:600;color:#6a7a8a;margin:34px 0 22px 0;text-align:center;letter-spacing:1px;",
  "h2": "font-size:16px;font-weight:600;color:#7a8a9a;margin:24px 0 14px 0;padding:0 0 8px 0;border-bottom:1px solid #e0e4ea;",
  "h3": "font-size:15px;font-weight:600;color:#8a9aaa;margin:20px 0 10px 0;",
  "h4": "font-size:14px;font-weight:500;color:#9aaaba;margin:16px 0 8px 0;",
  "p": "margin:14px 0;font-size:15px;color:#6a6a7a;",
  "strong": "color:#5a6a7a;font-weight:700;",
  "em": "color:#8a9aaa;font-style:italic;",
  "blockquote": "margin:20px 0;padding:18px 24px;background:rgba(220,225,235,0.15);border-radius:12px;color:#7a8a9a;font-size:14px;border:1px solid rgba(200,210,225,0.3);",
  "pre": "margin:18px 0;padding:18px;background:#fafbfd;border-radius:10px;font-size:13px;line-height:1.7;border:1px solid rgba(200,210,225,0.25);color:#5a5a6a;",
  "code": "font-family:'Consolas',monospace;background:rgba(200,210,225,0.12);color:#6a7a8a;padding:2px 8px;border-radius:6px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:20px;list-style-type:none;",
  "ul li::before": "content:'—';color:#b0b8c0;font-size:14px;margin-right:10px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:10px 0;font-size:15px;color:#6a6a7a;",
  "a": "color:#6a8aaa;text-decoration:none;border-bottom:1px solid rgba(120,150,180,0.3);",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;border-radius:8px;overflow:hidden;",
  "th": "background:rgba(200,210,225,0.3);color:#6a7a8a;font-weight:600;padding:10px 16px;border:none;",
  "td": "padding:9px 16px;border-bottom:1px solid rgba(200,210,225,0.2);color:#6a6a7a;",
  "hr": "border:none;border-top:1px solid #e8ecf0;margin:34px 0;",
  "del": "color:#c0c8d0;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}