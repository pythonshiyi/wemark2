{
  "_page_style": "body{max-width:680px;margin:0 auto;padding:20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;color:#2d3436;line-height:1.85;background:#fff;}",
  "h1": "font-size:22px;font-weight:800;color:#0984e3;margin:24px 0 16px 0;padding:10px 0;border-bottom:3px solid #74b9ff;",
  "h2": "font-size:18px;font-weight:700;color:#2d3436;margin:20px 0 12px 0;padding-left:10px;border-left:4px solid #0984e3;",
  "h3": "font-size:16px;font-weight:700;color:#636e72;margin:16px 0 10px 0;",
  "h4": "font-size:15px;font-weight:600;color:#b2bec3;margin:14px 0 8px 0;",
  "p": "margin:10px 0;font-size:15px;color:#2d3436;",
  "strong": "color:#0984e3;font-weight:700;",
  "em": "color:#636e72;",
  "blockquote": "margin:16px 0;padding:14px 18px;background:linear-gradient(135deg,#e8f4fd,#f0f8ff);border-radius:6px;color:#636e72;font-size:14px;border:1px solid #dfe6e9;",
  "pre": "margin:16px 0;padding:16px;background-color:#2d3436;color:#dfe6e9;border-radius:6px;overflow-x:auto;font-size:14px;line-height:1.6;",
  "pre code": "background-color:transparent;color:#dfe6e9;",
  "code": "font-family:'Consolas','Courier New',monospace;background-color:#f0f0f0;color:#e17055;padding:2px 6px;border-radius:3px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:24px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:5px 0;font-size:15px;color:#2d3436;",
  "a": "color:#0984e3;text-decoration:none;border-bottom:1px solid #74b9ff;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;box-shadow:0 1px 4px rgba(0,0,0,0.05);",
  "th": "background-color:#0984e3;color:#fff;font-weight:700;padding:10px 14px;border:none;",
  "td": "padding:9px 14px;border-bottom:1px solid #dfe6e9;color:#2d3436;",
  "hr": "border:none;border-top:2px solid #dfe6e9;margin:24px 0;",
  "del": "color:#b2bec3;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}