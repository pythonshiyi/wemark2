{
  "_page_style": "body{max-width:660px;margin:0 auto;padding:28px 24px;font-family:'PingFang SC','Microsoft YaHei',sans-serif;color:#3a5a6a;line-height:2;background:linear-gradient(180deg,#f0f8ff,#fafefe,#f0f8ff);}",
  "h1": "font-size:22px;font-weight:700;color:#1a6078;margin:26px 0 16px 0;text-align:center;letter-spacing:0.5px;",
  "h2": "font-size:18px;font-weight:600;color:#2a8098;margin:20px 0 12px 0;padding:10px 16px;background:linear-gradient(to right,rgba(140,210,230,0.3),transparent);border-radius:0 20px 20px 0;",
  "h3": "font-size:16px;font-weight:600;color:#3a90a8;margin:16px 0 10px 0;",
  "h4": "font-size:14px;font-weight:500;color:#5aa0b8;margin:12px 0 8px 0;",
  "p": "margin:10px 0;font-size:15px;color:#4a6a7a;",
  "strong": "color:#1a6078;font-weight:700;",
  "em": "color:#6a90a0;font-style:italic;",
  "blockquote": "margin:16px 0;padding:16px 20px;background:rgba(200,230,240,0.25);border-radius:14px;color:#4a7a8a;font-size:14px;border:1px solid rgba(160,210,225,0.4);",
  "pre": "margin:16px 0;padding:16px;background:rgba(240,248,255,0.8);border-radius:10px;font-size:13px;line-height:1.7;border:1px solid rgba(180,210,225,0.4);color:#3a5a6a;",
  "code": "font-family:'Consolas',monospace;background:rgba(200,225,240,0.3);color:#1a6078;padding:2px 8px;border-radius:6px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:20px;list-style-type:none;",
  "ul li::before": "content:'~';color:#60b0c8;font-size:16px;margin-right:8px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:7px 0;font-size:15px;color:#4a6a7a;",
  "a": "color:#2a8098;text-decoration:none;border-bottom:1px solid rgba(100,180,200,0.4);",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;border-radius:10px;overflow:hidden;",
  "th": "background:linear-gradient(135deg,#60b0c8,#8cd0e0);color:#fff;font-weight:600;padding:10px 14px;border:none;",
  "td": "padding:9px 14px;border-bottom:1px solid rgba(160,210,225,0.3);color:#4a6a7a;",
  "hr": "border:none;height:1px;background:linear-gradient(to right,transparent,rgba(140,200,215,0.5),transparent);margin:28px 0;",
  "del": "color:#b0c8d0;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}