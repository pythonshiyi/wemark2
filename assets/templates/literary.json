{
  "_page_style": "body{max-width:680px;margin:0 auto;padding:24px;font-family:'Georgia','Times New Roman','Songti SC',serif;color:#2c2c2c;line-height:2;background:#fdfaf6;}",
  "h1": "font-size:24px;font-weight:700;color:#1a1a1a;margin:28px 0 18px 0;text-align:center;letter-spacing:1px;",
  "h2": "font-size:18px;font-weight:700;color:#4a3728;margin:22px 0 14px 0;border-left:3px solid #c9a87c;padding-left:12px;",
  "h3": "font-size:16px;font-weight:700;color:#6b5a4b;margin:18px 0 10px 0;",
  "h4": "font-size:15px;font-weight:700;color:#8b7355;margin:14px 0 8px 0;",
  "p": "margin:12px 0;font-size:16px;color:#3a3a3a;text-align:justify;text-indent:2em;",
  "strong": "color:#4a3728;font-weight:700;",
  "em": "color:#8b7355;font-style:italic;",
  "blockquote": "margin:20px 0;padding:16px 20px;border-left:3px solid #c9a87c;background-color:#f5efe6;color:#6b5a4b;font-style:italic;font-size:15px;",
  "pre": "margin:16px 0;padding:16px;background-color:#f5efe6;border-radius:4px;font-size:14px;line-height:1.8;border:1px solid #e0d5c4;",
  "code": "font-family:'Consolas',monospace;background-color:#f0e8d8;color:#8b4513;padding:2px 6px;border-radius:3px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:24px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:6px 0;font-size:16px;color:#3a3a3a;",
  "a": "color:#8b6914;text-decoration:none;border-bottom:1px dashed #8b6914;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;",
  "th": "background-color:#f5efe6;color:#4a3728;font-weight:700;padding:10px;border:1px solid #e0d5c4;",
  "td": "padding:8px 10px;border:1px solid #e0d5c4;",
  "hr": "border:none;border-top:1px dashed #d0c0a8;margin:24px 0;",
  "del": "color:#bbb;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}