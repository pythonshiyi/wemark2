{
  "_page_style": "body{max-width:640px;margin:0 auto;padding:32px 28px;font-family:'PingFang SC','Microsoft YaHei',sans-serif;color:#5c4a3a;line-height:2;background:#faf6f0;}",
  "h1": "font-size:21px;font-weight:700;color:#8b6914;margin:30px 0 18px 0;padding-bottom:14px;border-bottom:1px dashed #d4c4a0;letter-spacing:1px;",
  "h2": "font-size:17px;font-weight:600;color:#a07828;margin:24px 0 12px 0;padding-left:14px;border-left:2px solid #d4b860;",
  "h3": "font-size:15px;font-weight:600;color:#8b6914;margin:18px 0 10px 0;",
  "h4": "font-size:14px;font-weight:500;color:#a08060;margin:14px 0 8px 0;",
  "p": "margin:12px 0;font-size:15px;color:#6b5a4a;",
  "strong": "color:#6b4410;font-weight:700;",
  "em": "color:#9a8460;font-style:italic;",
  "blockquote": "margin:18px 0;padding:16px 20px;background:linear-gradient(135deg,#faf3e8,#f5ecd8);border-radius:12px;color:#7a6a50;font-size:14px;border:1px solid #e8d8c0;",
  "pre": "margin:16px 0;padding:16px;background:#faf3e8;border-radius:10px;font-size:13px;line-height:1.7;border:1px solid #e8d8c0;color:#5c4a3a;",
  "code": "font-family:'Consolas',monospace;background:#f0e4d0;color:#8b6914;padding:2px 8px;border-radius:6px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:24px;list-style-type:none;",
  "ul li::before": "content:'·';color:#d4b860;font-weight:bold;font-size:20px;margin-right:8px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:8px 0;font-size:15px;color:#6b5a4a;",
  "a": "color:#a07828;text-decoration:none;border-bottom:1px dashed #d4b860;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;border-radius:10px;overflow:hidden;",
  "th": "background:#f0e4d0;color:#6b4410;font-weight:600;padding:10px 14px;border:none;",
  "td": "padding:9px 14px;border-bottom:1px solid #f0e4d0;color:#6b5a4a;",
  "hr": "border:none;border-top:1px dashed #d4c4a0;margin:28px 0;",
  "del": "color:#c4b090;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}