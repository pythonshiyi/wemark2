{
  "_page_style": "body{max-width:680px;margin:0 auto;padding:22px;font-family:'PingFang SC','Microsoft YaHei','Georgia',serif;color:#d4c5a9;line-height:2;background:#1a1410;}",
  "h1": "font-size:23px;font-weight:700;color:#c9a87c;margin:24px 0 16px 0;text-align:center;letter-spacing:2px;border-bottom:1px solid #3a2a1a;padding-bottom:12px;",
  "h2": "font-size:18px;font-weight:700;color:#d4b896;margin:20px 0 12px 0;padding-left:10px;border-left:3px solid #c9a87c;",
  "h3": "font-size:16px;font-weight:700;color:#b8956a;margin:16px 0 10px 0;",
  "h4": "font-size:15px;font-weight:600;color:#8a6d4b;margin:12px 0 8px 0;",
  "p": "margin:12px 0;font-size:15px;color:#c4b5a0;text-align:justify;",
  "strong": "color:#e8d5b0;font-weight:700;",
  "em": "color:#a88d6a;font-style:italic;",
  "blockquote": "margin:18px 0;padding:16px 20px;border:1px solid #3a2a1a;border-left:4px solid #c9a87c;background:rgba(201,168,124,0.08);color:#b0a090;font-style:italic;",
  "pre": "margin:16px 0;padding:16px;background:#0d0a07;border-radius:4px;font-size:14px;line-height:1.7;border:1px solid #3a2a1a;color:#c4b5a0;",
  "code": "font-family:'Consolas',monospace;background:#2a1a0a;color:#d4a853;padding:2px 6px;border-radius:3px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:24px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:6px 0;font-size:15px;color:#c4b5a0;",
  "a": "color:#c9a87c;text-decoration:none;border-bottom:1px solid #5a4a2a;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;",
  "th": "background:#3a2a1a;color:#c9a87c;font-weight:700;padding:10px 14px;border:1px solid #5a4a2a;",
  "td": "padding:9px 14px;border:1px solid #3a2a1a;color:#c4b5a0;",
  "hr": "border:none;border-top:1px solid #3a2a1a;margin:24px 0;",
  "del": "color:#5a4a2a;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}