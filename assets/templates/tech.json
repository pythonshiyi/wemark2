{
  "_page_style": "body{max-width:680px;margin:0 auto;padding:20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;color:#e0e0e0;line-height:1.8;background:#1a1a2e;}",
  "h1": "font-size:22px;font-weight:700;color:#00d4ff;margin:24px 0 16px 0;padding-bottom:8px;border-bottom:2px solid #00d4ff;",
  "h2": "font-size:18px;font-weight:700;color:#00b8d4;margin:20px 0 12px 0;",
  "h3": "font-size:16px;font-weight:700;color:#36b8d4;margin:16px 0 10px 0;",
  "h4": "font-size:15px;font-weight:700;color:#5cc8d4;margin:14px 0 8px 0;",
  "p": "margin:10px 0;font-size:15px;color:#b8c8d8;letter-spacing:0.5px;",
  "strong": "color:#ffffff;font-weight:700;",
  "em": "color:#8cb8d8;font-style:italic;",
  "blockquote": "margin:16px 0;padding:12px 16px;border-left:4px solid #00d4ff;background-color:#0d1b3e;color:#8cb8d8;font-size:14px;",
  "pre": "margin:16px 0;padding:16px;background-color:#0d1b3e;border-radius:6px;overflow-x:auto;font-size:14px;line-height:1.6;border:1px solid #1a3a5c;",
  "code": "font-family:'Consolas','Courier New',monospace;background-color:#0d1b3e;color:#00d4ff;padding:2px 6px;border-radius:3px;font-size:13px;border:1px solid #1a3a5c;",
  "ul": "margin:10px 0;padding-left:24px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:4px 0;font-size:15px;color:#b8c8d8;",
  "a": "color:#00d4ff;text-decoration:none;border-bottom:1px solid #00d4ff;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;",
  "th": "background-color:#0d1b3e;color:#00d4ff;font-weight:700;padding:10px 12px;border:1px solid #1a3a5c;",
  "td": "padding:8px 12px;border:1px solid #1a3a5c;color:#b8c8d8;",
  "hr": "border:none;border-top:1px solid #1a3a5c;margin:24px 0;",
  "del": "color:#555;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}