{
  "_page_style": "body{max-width:700px;margin:0 auto;padding:30px 24px;font-family:'PingFang SC','Microsoft YaHei','Georgia',serif;color:#333;line-height:1.9;background:#fff;}",
  "h1": "font-size:20px;font-weight:700;color:#000;margin:28px 0 16px 0;text-align:center;letter-spacing:0.5px;",
  "h2": "font-size:17px;font-weight:700;color:#111;margin:22px 0 12px 0;padding-bottom:4px;border-bottom:1px solid #e0e0e0;",
  "h3": "font-size:15px;font-weight:700;color:#222;margin:16px 0 10px 0;",
  "h4": "font-size:14px;font-weight:600;color:#555;margin:12px 0 8px 0;font-style:italic;",
  "p": "margin:12px 0;font-size:15px;color:#444;text-align:justify;text-indent:2em;line-height:2;",
  "strong": "color:#000;font-weight:700;",
  "em": "color:#666;font-style:italic;",
  "blockquote": "margin:18px 0;padding:0 16px;border-left:2px solid #333;color:#666;font-style:italic;font-size:14px;background:transparent;",
  "pre": "margin:16px 0;padding:16px;background:#f8f8f8;border-radius:3px;font-size:13px;line-height:1.6;border:1px solid #e8e8e8;color:#333;",
  "code": "font-family:'Consolas',monospace;background:#f4f4f4;color:#333;padding:2px 5px;border-radius:2px;font-size:13px;border:1px solid #eee;",
  "ul": "margin:10px 0;padding-left:24px;list-style-type:none;",
  "ul li:before": "content:'— ';",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:6px 0;font-size:15px;color:#444;",
  "a": "color:#333;text-decoration:none;border-bottom:1px solid #aaa;",
  "img": "max-width:100%;height:auto;margin:16px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:18px 0;font-size:14px;border-top:2px solid #333;border-bottom:1px solid #333;",
  "th": "background:#fff;color:#000;font-weight:700;padding:10px 14px;border-bottom:1px solid #333;text-align:left;",
  "td": "padding:9px 14px;border-bottom:1px solid #e0e0e0;color:#444;",
  "hr": "border:none;border-top:1px solid #ddd;margin:28px 0;",
  "del": "color:#aaa;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}