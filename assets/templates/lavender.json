{
  "_page_style": "body{max-width:640px;margin:0 auto;padding:30px 26px;font-family:'PingFang SC','Microsoft YaHei','Georgia',serif;color:#4a3a5a;line-height:2;background:linear-gradient(180deg,#f9f5fe,#fefafe,#f9f5fe);}",
  "h1": "font-size:21px;font-weight:700;color:#6a4a9a;margin:30px 0 20px 0;text-align:center;letter-spacing:1px;font-family:'Georgia','KaiTi',serif;",
  "h2": "font-size:17px;font-weight:600;color:#7a5aaa;margin:22px 0 14px 0;padding:10px 16px;background:rgba(170,130,210,0.12);border-radius:12px;border-left:3px solid #b08ad0;",
  "h3": "font-size:15px;font-weight:600;color:#8a6aba;margin:18px 0 10px 0;",
  "h4": "font-size:14px;font-weight:500;color:#9a7aca;margin:14px 0 8px 0;",
  "p": "margin:10px 0;font-size:15px;color:#5a4a6a;",
  "strong": "color:#5a3a8a;font-weight:700;",
  "em": "color:#8a7aaa;font-style:italic;",
  "blockquote": "margin:18px 0;padding:18px 22px;background:rgba(200,180,230,0.15);border-radius:14px;color:#6a5a7a;font-size:14px;border:1px solid rgba(180,150,210,0.25);",
  "pre": "margin:16px 0;padding:16px;background:#faf6fe;border-radius:10px;font-size:13px;line-height:1.7;border:1px solid rgba(180,150,210,0.2);color:#4a3a5a;",
  "code": "font-family:'Consolas',monospace;background:rgba(180,150,210,0.15);color:#6a4a9a;padding:2px 8px;border-radius:6px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:20px;list-style-type:none;",
  "ul li::before": "content:'✧';color:#b08ad0;font-size:12px;margin-right:8px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:8px 0;font-size:15px;color:#5a4a6a;",
  "a": "color:#7a5aaa;text-decoration:none;border-bottom:1px solid rgba(150,110,190,0.3);",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;border-radius:10px;overflow:hidden;",
  "th": "background:linear-gradient(135deg,#9a7aca,#c0a0e0);color:#fff;font-weight:600;padding:10px 14px;border:none;",
  "td": "padding:9px 14px;border-bottom:1px solid rgba(180,150,210,0.2);color:#5a4a6a;",
  "hr": "border:none;height:1px;background:linear-gradient(to right,transparent,rgba(170,140,200,0.4),transparent);margin:30px 0;",
  "del": "color:#c0b0d0;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}