{
  "_page_style": "body{max-width:680px;margin:0 auto;padding:20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;color:#333;line-height:1.8;}",
  "h1": "font-size:22px;font-weight:700;color:#1a1a1a;margin:24px 0 16px 0;padding-bottom:8px;border-bottom:2px solid #1a73e8;",
  "h2": "font-size:18px;font-weight:700;color:#1a1a1a;margin:20px 0 12px 0;",
  "h3": "font-size:16px;font-weight:700;color:#333;margin:16px 0 10px 0;",
  "h4": "font-size:15px;font-weight:700;color:#555;margin:14px 0 8px 0;",
  "p": "margin:10px 0;font-size:15px;color:#333;letter-spacing:0.5px;",
  "strong": "color:#1a1a1a;font-weight:700;",
  "em": "color:#666;font-style:italic;",
  "blockquote": "margin:16px 0;padding:12px 16px;border-left:4px solid #1a73e8;background-color:#f0f7ff;color:#555;font-size:14px;",
  "pre": "margin:16px 0;padding:16px;background-color:#f5f5f5;border-radius:6px;overflow-x:auto;font-size:14px;line-height:1.6;",
  "code": "font-family:'Consolas','Courier New',monospace;background-color:#f0f0f0;color:#d32f2f;padding:2px 6px;border-radius:3px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:24px;list-style-type:disc;",
  "ol": "margin:10px 0;padding-left:24px;list-style-type:decimal;",
  "li": "margin:4px 0;font-size:15px;color:#333;",
  "a": "color:#1a73e8;text-decoration:none;border-bottom:1px solid #1a73e8;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;",
  "th": "background-color:#f0f7ff;color:#1a1a1a;font-weight:700;padding:10px 12px;border:1px solid #e0e0e0;",
  "td": "padding:8px 12px;border:1px solid #e0e0e0;color:#333;",
  "hr": "border:none;border-top:1px solid #e0e0e0;margin:24px 0;",
  "del": "color:#999;text-decoration:line-through;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}