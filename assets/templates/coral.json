{
  "_page_style": "body{max-width:660px;margin:0 auto;padding:28px 24px;font-family:'PingFang SC','Microsoft YaHei','Georgia','Noto Serif SC',serif;color:#3d2c2a;line-height:2;background:#fef9f7;}",
  "h1": "font-size:24px;font-weight:700;color:#c44536;margin:32px 0 18px 0;padding-bottom:12px;border-bottom:2px solid #e8b4a8;text-align:center;letter-spacing:1px;",
  "h2": "font-size:19px;font-weight:700;color:#c44536;margin:24px 0 14px 0;padding-left:14px;border-left:3px solid #e8b4a8;",
  "h3": "font-size:17px;font-weight:600;color:#5a3d3b;margin:18px 0 10px 0;",
  "h4": "font-size:15px;font-weight:600;color:#7a5550;margin:14px 0 8px 0;",
  "h5": "font-size:14px;font-weight:600;color:#8a6560;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:700;color:#9a7570;margin:10px 0 4px 0;letter-spacing:0.5px;",
  "p": "margin:12px 0;font-size:15px;color:#3d2c2a;text-align:justify;",
  "strong": "color:#c44536;font-weight:700;",
  "em": "color:#8a6560;font-style:italic;",
  "blockquote": "margin:20px 0;padding:16px 22px;border:1px solid #f0ddd8;border-left:4px solid #c44536;background:#fdf4f0;color:#6a4d48;font-size:14px;border-radius:0 6px 6px 0;",
  "pre": "margin:16px 0;padding:16px 18px;background:#f5ece8;border-radius:6px;overflow-x:auto;font-size:14px;line-height:1.7;border:1px solid #e8d5ce;color:#3d2c2a;",
  "code": "font-family:'Consolas','JetBrains Mono',monospace;background:#f5ece8;color:#c44536;padding:2px 6px;border-radius:3px;font-size:13px;border:1px solid #e8d5ce;",
  "pre code": "background:transparent;border:none;color:#3d2c2a;padding:0;font-size:14px;",
  "ul": "margin:10px 0;padding-left:24px;list-style-type:disc;",
  "ol": "margin:10px 0;padding-left:24px;list-style-type:decimal;",
  "li": "margin:6px 0;font-size:15px;color:#3d2c2a;",
  "a": "color:#c44536;text-decoration:none;border-bottom:1px solid #e8b4a8;font-weight:500;",
  "img": "max-width:100%;height:auto;border-radius:8px;margin:16px auto;display:block;box-shadow:0 3px 10px rgba(196,69,54,0.08);",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;border-radius:6px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.04);",
  "th": "background-color:#c44536;color:#fff;font-weight:600;padding:10px 14px;border:none;",
  "td": "padding:9px 14px;border:none;color:#3d2c2a;border-bottom:1px solid #f0ddd8;background:#fff;",
  "hr": "border:none;height:2px;background:linear-gradient(90deg,transparent,#e8b4a8,transparent);margin:28px 0;",
  "del": "color:#b89a95;text-decoration:line-through;"
}
