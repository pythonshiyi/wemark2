{
  "_page_style": "body{max-width:680px;margin:0 auto;padding:24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;color:#444;line-height:1.9;background:#fff;}",
  "h1": "font-size:20px;font-weight:700;color:#111;margin:20px 0 14px 0;letter-spacing:-0.5px;",
  "h2": "font-size:17px;font-weight:700;color:#222;margin:18px 0 10px 0;",
  "h3": "font-size:15px;font-weight:700;color:#444;margin:14px 0 8px 0;",
  "h4": "font-size:14px;font-weight:700;color:#666;margin:12px 0 6px 0;",
  "p": "margin:8px 0;font-size:15px;color:#555;",
  "strong": "color:#222;font-weight:700;",
  "em": "color:#777;",
  "blockquote": "margin:12px 0;padding:10px 14px;border-left:3px solid #ddd;color:#888;font-size:14px;",
  "pre": "margin:14px 0;padding:14px;background-color:#fafafa;border-radius:4px;font-size:13px;line-height:1.6;border:1px solid #eee;",
  "code": "font-family:'Consolas',monospace;background-color:#f5f5f5;color:#c7254e;padding:1px 5px;border-radius:2px;font-size:13px;",
  "ul": "margin:8px 0;padding-left:20px;",
  "ol": "margin:8px 0;padding-left:20px;",
  "li": "margin:3px 0;font-size:15px;color:#555;",
  "a": "color:#555;text-decoration:none;border-bottom:1px solid #ccc;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:14px 0;font-size:14px;",
  "th": "background-color:#fafafa;color:#222;font-weight:600;padding:8px 10px;border-bottom:2px solid #ddd;",
  "td": "padding:8px 10px;border-bottom:1px solid #eee;",
  "hr": "border:none;border-top:1px solid #eee;margin:20px 0;",
  "del": "color:#ccc;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}