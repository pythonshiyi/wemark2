{
  "_page_style": "body{max-width:650px;margin:0 auto;padding:36px 28px;font-family:'PingFang SC','Microsoft YaHei','Georgia',serif;color:#4a4a4a;line-height:2;background:#fefefa;}",
  "h1": "font-size:20px;font-weight:600;color:#3a3a3a;margin:30px 0 20px 0;text-align:center;padding-bottom:16px;border-bottom:1px solid #e8e8e0;",
  "h2": "font-size:16px;font-weight:600;color:#4a4a4a;margin:24px 0 14px 0;padding:4px 0 4px 12px;border-left:2px solid #c0c0b0;",
  "h3": "font-size:15px;font-weight:600;color:#555;margin:18px 0 10px 0;",
  "h4": "font-size:14px;font-weight:500;color:#6a6a6a;margin:14px 0 8px 0;",
  "p": "margin:12px 0;font-size:15px;color:#4a4a4a;",
  "strong": "color:#2a2a2a;font-weight:700;",
  "em": "color:#7a7a7a;font-style:italic;",
  "blockquote": "margin:18px 0;padding:14px 18px;background:#fafaf6;border-radius:4px;color:#6a6a6a;font-size:14px;border:1px solid #ecece4;border-left:3px solid #c0c0b0;",
  "pre": "margin:16px 0;padding:16px;background:#fcfcf8;border-radius:6px;font-size:13px;line-height:1.7;border:1px solid #eee;color:#4a4a4a;",
  "code": "font-family:'Consolas',monospace;background:#f6f6f2;color:#5a5a5a;padding:2px 6px;border-radius:3px;font-size:13px;border:1px solid #e8e8e4;",
  "ul": "margin:10px 0;padding-left:20px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:8px 0;font-size:15px;color:#4a4a4a;",
  "a": "color:#5a5a5a;text-decoration:none;border-bottom:2px solid #d8d8d0;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;border-top:2px solid #c0c0b0;border-bottom:2px solid #c0c0b0;",
  "th": "background:#fafaf6;color:#3a3a3a;font-weight:600;padding:10px 14px;border-bottom:1px solid #ddd;",
  "td": "padding:9px 14px;border-bottom:1px solid #ecece4;color:#4a4a4a;",
  "hr": "border:none;border-top:1px solid #e0e0d8;margin:30px 0;",
  "del": "color:#b0b0b0;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}