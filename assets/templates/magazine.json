{
  "_page_style": "body{max-width:680px;margin:0 auto;padding:0;font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;color:#1a1a1a;line-height:1.8;background:#fff;}",
  "h1": "font-size:28px;font-weight:900;color:#000;margin:30px 20px 8px 20px;letter-spacing:-0.5px;text-transform:uppercase;",
  "h2": "font-size:20px;font-weight:800;color:#111;margin:24px 20px 10px 20px;padding:6px 0;border-top:3px solid #000;border-bottom:1px solid #e0e0e0;text-transform:uppercase;letter-spacing:1px;",
  "h3": "font-size:17px;font-weight:700;color:#222;margin:18px 20px 8px 20px;",
  "h4": "font-size:15px;font-weight:700;color:#444;margin:14px 20px 6px 20px;",
  "p": "margin:10px 20px;font-size:16px;color:#333;",
  "strong": "color:#000;font-weight:800;background:linear-gradient(0deg,#ff0,#ff0);background-size:100% 40%;background-repeat:no-repeat;background-position:0 90%;padding:0 2px;",
  "em": "color:#666;font-style:italic;font-size:18px;",
  "blockquote": "margin:20px 20px;padding:20px 24px;background:#000;color:#fff;font-size:18px;font-weight:700;line-height:1.6;text-align:center;",
  "pre": "margin:16px 20px;padding:16px;background:#f8f8f8;border-radius:0;font-size:14px;line-height:1.6;border-left:4px solid #000;",
  "code": "font-family:'Consolas',monospace;background:#f0f0f0;color:#e74c3c;padding:2px 5px;font-size:13px;",
  "ul": "margin:8px 20px;padding-left:20px;list-style:none;",
  "ul li": "margin:6px 0;font-size:16px;color:#333;",
  "ol": "margin:8px 20px;padding-left:20px;",
  "li": "margin:6px 0;font-size:16px;color:#333;",
  "a": "color:#000;text-decoration:none;font-weight:700;border-bottom:2px solid #ff0;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;margin:16px 20px;font-size:14px;border-collapse:collapse;",
  "th": "background:#000;color:#fff;font-weight:700;padding:10px 14px;border:none;text-transform:uppercase;font-size:12px;letter-spacing:1px;",
  "td": "padding:10px 14px;border-bottom:1px solid #e0e0e0;color:#333;",
  "hr": "border:none;border-top:4px solid #000;margin:30px 20px;",
  "del": "color:#ccc;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}