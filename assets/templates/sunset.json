{
  "_page_style": "body{max-width:640px;margin:0 auto;padding:30px 26px;font-family:'PingFang SC','Microsoft YaHei',sans-serif;color:#5a4a40;line-height:2;background:linear-gradient(180deg,#fef9f4,#fff5f0,#fef9f4);}",
  "h1": "font-size:22px;font-weight:700;color:#c06030;margin:28px 0 18px 0;text-align:center;",
  "h2": "font-size:18px;font-weight:600;color:#d07040;margin:22px 0 14px 0;padding:8px 16px;background:linear-gradient(to right,rgba(255,180,130,0.25),transparent);border-radius:0 16px 16px 0;",
  "h3": "font-size:16px;font-weight:600;color:#c06840;margin:18px 0 10px 0;",
  "h4": "font-size:14px;font-weight:500;color:#d09060;margin:14px 0 8px 0;",
  "p": "margin:10px 0;font-size:15px;color:#6a5a50;",
  "strong": "color:#b05028;font-weight:700;",
  "em": "color:#c09070;font-style:italic;",
  "blockquote": "margin:16px 0;padding:16px 20px;background:rgba(255,220,180,0.2);border-radius:12px;color:#7a6a5a;font-size:14px;border:1px solid rgba(240,180,140,0.3);",
  "pre": "margin:16px 0;padding:16px;background:#fefaf6;border-radius:10px;font-size:13px;line-height:1.7;border:1px solid rgba(240,180,140,0.3);color:#5a4a40;",
  "code": "font-family:'Consolas',monospace;background:rgba(255,210,160,0.2);color:#c06030;padding:2px 8px;border-radius:6px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:20px;list-style-type:none;",
  "ul li::before": "content:'•';color:#e0a060;font-size:14px;margin-right:8px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:8px 0;font-size:15px;color:#6a5a50;",
  "a": "color:#c06030;text-decoration:none;border-bottom:1px solid rgba(220,140,80,0.4);",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;border-radius:10px;overflow:hidden;",
  "th": "background:linear-gradient(135deg,#f0a060,#f8c090);color:#fff;font-weight:600;padding:10px 14px;border:none;",
  "td": "padding:9px 14px;border-bottom:1px solid rgba(240,200,160,0.3);color:#6a5a50;",
  "hr": "border:none;height:1px;background:linear-gradient(to right,transparent,rgba(220,160,100,0.4),transparent);margin:28px 0;",
  "del": "color:#c8b8a0;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}