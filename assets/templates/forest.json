{
  "_page_style": "body{max-width:650px;margin:0 auto;padding:28px 26px;font-family:'PingFang SC','Microsoft YaHei',sans-serif;color:#3a4a30;line-height:2;background:linear-gradient(180deg,#f5faf0,#fafff5,#f5faf0);}",
  "h1": "font-size:21px;font-weight:700;color:#4a6a2a;margin:28px 0 18px 0;padding-bottom:12px;border-bottom:1px solid #c8d8b8;letter-spacing:0.5px;",
  "h2": "font-size:17px;font-weight:600;color:#5a7a3a;margin:22px 0 14px 0;padding:8px 16px;background:linear-gradient(to right,rgba(160,200,120,0.2),transparent);border-radius:0 12px 12px 0;border-left:3px solid #9ab868;",
  "h3": "font-size:15px;font-weight:600;color:#6a8a4a;margin:18px 0 10px 0;",
  "h4": "font-size:14px;font-weight:500;color:#7a9a5a;margin:14px 0 8px 0;",
  "p": "margin:10px 0;font-size:15px;color:#4a5a40;",
  "strong": "color:#3a5a1a;font-weight:700;",
  "em": "color:#6a8a50;font-style:italic;",
  "blockquote": "margin:16px 0;padding:16px 20px;background:rgba(180,210,140,0.12);border-radius:12px;color:#5a6a4a;font-size:14px;border:1px solid rgba(160,200,120,0.25);",
  "pre": "margin:16px 0;padding:16px;background:#f8fcf4;border-radius:10px;font-size:13px;line-height:1.7;border:1px solid rgba(160,200,120,0.2);color:#3a4a30;",
  "code": "font-family:'Consolas',monospace;background:rgba(160,200,120,0.15);color:#4a6a2a;padding:2px 8px;border-radius:6px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:20px;list-style-type:none;",
  "ul li::before": "content:'✦';color:#8ab858;font-size:10px;margin-right:8px;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:8px 0;font-size:15px;color:#4a5a40;",
  "a": "color:#5a7a3a;text-decoration:none;border-bottom:1px solid rgba(120,170,80,0.3);",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;border-radius:10px;overflow:hidden;",
  "th": "background:linear-gradient(135deg,#8ab858,#a8d878);color:#fff;font-weight:600;padding:10px 14px;border:none;",
  "td": "padding:9px 14px;border-bottom:1px solid rgba(160,200,120,0.25);color:#4a5a40;",
  "hr": "border:none;height:1px;background:linear-gradient(to right,transparent,rgba(150,190,110,0.4),transparent);margin:30px 0;",
  "del": "color:#b8c8a0;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}