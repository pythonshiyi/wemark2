{
  "_page_style": "body{max-width:680px;margin:0 auto;padding:24px 20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;color:#2e3440;line-height:1.9;background:#eceff4;}",
  "h1": "font-size:22px;font-weight:700;color:#2e3440;margin:28px 0 16px 0;padding-bottom:10px;border-bottom:2px solid #81a1c1;",
  "h2": "font-size:18px;font-weight:700;color:#3b4252;margin:22px 0 12px 0;padding-left:0;",
  "h3": "font-size:16px;font-weight:600;color:#434c5e;margin:18px 0 10px 0;",
  "h4": "font-size:15px;font-weight:600;color:#4c566a;margin:14px 0 8px 0;",
  "h5": "font-size:14px;font-weight:600;color:#5e687e;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:700;color:#6e7890;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;",
  "p": "margin:10px 0;font-size:15px;color:#3b4252;letter-spacing:0.3px;",
  "strong": "color:#2e3440;font-weight:700;",
  "em": "color:#5e687e;font-style:italic;",
  "blockquote": "margin:16px 0;padding:14px 18px;border-left:4px solid #81a1c1;background-color:#e5e9f0;color:#4c566a;font-size:14px;border-radius:0 4px 4px 0;",
  "pre": "margin:16px 0;padding:16px 18px;background-color:#2e3440;border-radius:6px;overflow-x:auto;font-size:14px;line-height:1.7;color:#d8dee9;",
  "code": "font-family:'Consolas','JetBrains Mono','Fira Code',monospace;background-color:#e5e9f0;color:#bf616a;padding:2px 6px;border-radius:3px;font-size:13px;",
  "pre code": "background:transparent;color:#d8dee9;padding:0;border-radius:0;font-size:14px;",
  "ul": "margin:10px 0;padding-left:24px;list-style-type:disc;",
  "ol": "margin:10px 0;padding-left:24px;list-style-type:decimal;",
  "li": "margin:5px 0;font-size:15px;color:#3b4252;",
  "a": "color:#5e81ac;text-decoration:none;font-weight:500;border-bottom:1px solid #81a1c1;",
  "img": "max-width:100%;height:auto;border-radius:6px;margin:16px auto;display:block;box-shadow:0 2px 8px rgba(46,52,64,0.12);",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;border-radius:4px;overflow:hidden;",
  "th": "background-color:#4c566a;color:#eceff4;font-weight:600;padding:10px 14px;border:none;",
  "td": "padding:10px 14px;border:none;color:#3b4252;border-bottom:1px solid #d8dee9;background-color:#ffffff;",
  "hr": "border:none;border-top:2px solid #d8dee9;margin:24px 0;",
  "del": "color:#a0a8b8;text-decoration:line-through;"
}
