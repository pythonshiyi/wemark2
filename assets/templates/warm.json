{
  "_page_style": "body{max-width:680px;margin:0 auto;padding:20px;font-family:'PingFang SC','Microsoft YaHei','Comic Sans MS',sans-serif;color:#5a4a5a;line-height:1.9;background:#fffbfe;}",
  "h1": "font-size:22px;font-weight:800;color:#c77dba;margin:22px 0 14px 0;text-align:center;",
  "h2": "font-size:18px;font-weight:700;color:#b565a7;margin:18px 0 10px 0;padding:6px 12px;background:#fdf0f9;border-radius:20px;display:inline-block;",
  "h3": "font-size:16px;font-weight:700;color:#a15a9a;margin:14px 0 8px 0;",
  "h4": "font-size:15px;font-weight:600;color:#c8a2c8;margin:12px 0 6px 0;",
  "p": "margin:10px 0;font-size:15px;color:#6a5a6a;",
  "strong": "color:#c77dba;font-weight:700;",
  "em": "color:#c8a2c8;font-style:italic;",
  "blockquote": "margin:14px 0;padding:14px 18px;background:linear-gradient(135deg,#fdf0f9,#fff5fb);border-radius:16px;color:#8a7a8a;font-size:14px;",
  "pre": "margin:14px 0;padding:14px;background:#fdf0f9;border-radius:12px;font-size:14px;line-height:1.7;border:1px solid #f0d4f0;",
  "code": "font-family:'Consolas',monospace;background:#fdf0f9;color:#c77dba;padding:2px 8px;border-radius:10px;font-size:13px;",
  "ul": "margin:10px 0;padding-left:24px;list-style-type:'🌸 ';",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:6px 0;font-size:15px;color:#6a5a6a;",
  "a": "color:#c77dba;text-decoration:none;border-bottom:1px dashed #e8c0e8;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;border-radius:12px;overflow:hidden;",
  "th": "background:linear-gradient(135deg,#e8b4e0,#f0d4f0);color:#5a3a5a;font-weight:700;padding:10px 14px;",
  "td": "padding:9px 14px;border-bottom:1px solid #f0e0f0;",
  "hr": "border:none;height:2px;background:linear-gradient(to right,transparent,#f0d4f0,transparent);margin:22px 0;",
  "del": "color:#d4c4d4;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}