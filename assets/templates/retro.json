{
  "_page_style": "body{max-width:680px;margin:0 auto;padding:20px;font-family:'PingFang SC','Microsoft YaHei','KaiTi','STKaiti',serif;color:#5a4a3a;line-height:2;background:#fdf8f0;}",
  "h1": "font-size:24px;font-weight:700;color:#8b4513;margin:24px 0 16px 0;text-align:center;font-family:'KaiTi','STKaiti',serif;",
  "h2": "font-size:18px;font-weight:700;color:#a0522d;margin:20px 0 12px 0;padding:8px 0;border-bottom:1px double #d4a574;font-family:'KaiTi','STKaiti',serif;",
  "h3": "font-size:16px;font-weight:700;color:#8b4513;margin:16px 0 10px 0;",
  "h4": "font-size:15px;font-weight:600;color:#a0522d;margin:14px 0 8px 0;",
  "p": "margin:12px 0;font-size:16px;color:#5a4a3a;text-align:justify;text-indent:2em;",
  "strong": "color:#6b3410;font-weight:700;",
  "em": "color:#a0522d;font-style:italic;",
  "blockquote": "margin:16px 0;padding:16px 20px;background:#faf3e6;border:1px solid #e0c8a8;border-radius:2px;color:#7a6a5a;font-family:'KaiTi','STKaiti',serif;font-size:15px;",
  "pre": "margin:16px 0;padding:16px;background:#faf3e6;border-radius:4px;font-size:14px;line-height:1.7;border:1px solid #e0c8a8;",
  "code": "font-family:'Consolas',monospace;background:#f0e0c8;color:#8b4513;padding:2px 6px;border-radius:2px;font-size:13px;border:1px solid #d4b896;",
  "ul": "margin:10px 0;padding-left:24px;list-style-type:square;",
  "ol": "margin:10px 0;padding-left:24px;",
  "li": "margin:6px 0;font-size:16px;color:#5a4a3a;",
  "a": "color:#8b4513;text-decoration:none;border-bottom:1px dotted #a0522d;",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;",
  "th": "background:#8b4513;color:#fdf8f0;font-weight:700;padding:10px 14px;border:1px solid #a0522d;",
  "td": "padding:9px 14px;border:1px solid #d4b896;color:#5a4a3a;background:#fefcf8;",
  "hr": "border:none;border-top:1px double #d4b896;margin:24px 0;",
  "del": "color:#c8b8a8;",
  "h5": "font-size:14px;font-weight:600;color:#666;margin:12px 0 6px 0;",
  "h6": "font-size:13px;font-weight:600;color:#888;margin:10px 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;"
}