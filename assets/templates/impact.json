{
  "_page_style": "body{max-width:680px;margin:0 auto;padding:0;font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;color:#fff;line-height:1.8;background:linear-gradient(135deg,#0f0c29,#302b63,#24243e);}",
  "h1": "font-size:32px;font-weight:900;color:#fff;margin:40px 24px 20px 24px;text-shadow:0 0 30px rgba(0,212,255,0.5);background:linear-gradient(90deg,#00d4ff,#7b2ff7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;",
  "h2": "font-size:20px;font-weight:800;color:#00d4ff;margin:30px 24px 14px 24px;padding:12px 16px;background:rgba(0,212,255,0.08);border-left:4px solid #00d4ff;border-radius:0 8px 8px 0;",
  "h3": "font-size:17px;font-weight:700;color:#7b2ff7;margin:22px 24px 10px 24px;",
  "h4": "font-size:15px;font-weight:600;color:#b388ff;margin:16px 24px 8px 24px;",
  "p": "margin:12px 24px;font-size:15px;color:#c8d8ff;",
  "strong": "color:#00d4ff;font-weight:800;text-shadow:0 0 10px rgba(0,212,255,0.3);",
  "em": "color:#b388ff;font-style:italic;",
  "blockquote": "margin:24px 24px;padding:20px 24px;background:rgba(255,255,255,0.05);border-radius:12px;border:1px solid rgba(0,212,255,0.2);color:#a0b8ff;font-size:16px;font-weight:500;text-align:center;backdrop-filter:blur(10px);",
  "pre": "margin:20px 24px;padding:18px;background:rgba(0,0,0,0.4);border-radius:8px;font-size:13px;line-height:1.6;border:1px solid rgba(0,212,255,0.15);color:#00d4ff;overflow-x:auto;",
  "code": "font-family:'Consolas',monospace;background:rgba(0,212,255,0.1);color:#00d4ff;padding:2px 6px;border-radius:3px;font-size:13px;",
  "ul": "margin:10px 24px;padding-left:20px;",
  "ol": "margin:10px 24px;padding-left:20px;",
  "li": "margin:6px 0;font-size:15px;color:#c8d8ff;",
  "a": "color:#00d4ff;text-decoration:none;font-weight:700;border-bottom:2px solid rgba(0,212,255,0.3);",
  "img": "max-width:100%;height:auto;border-radius:4px;margin:12px auto;display:block;",
  "table": "width:calc(100% - 48px);margin:20px 24px;font-size:14px;border-collapse:collapse;overflow:hidden;border-radius:8px;",
  "th": "background:linear-gradient(135deg,#302b63,#7b2ff7);color:#fff;font-weight:700;padding:12px 16px;border:none;",
  "td": "padding:10px 16px;border-bottom:1px solid rgba(255,255,255,0.08);color:#c8d8ff;background:rgba(255,255,255,0.02);",
  "hr": "border:none;border-top:1px solid rgba(0,212,255,0.2);margin:30px 24px;",
  "del": "color:#555;",
  "h5": "font-size:14px;font-weight:600;color:#b0c8ff;margin:12px 24px 6px 24px;",
  "h6": "font-size:13px;font-weight:600;color:#8899cc;margin:10px 24px 4px 24px;text-transform:uppercase;letter-spacing:0.5px;"
}